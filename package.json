{
  "name": "onboarding-tracker-webpart",
  "version": "0.0.3",
  "private": true,
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "scripts": {
    "build": "npm run tailwind-build && heft test --clean --production && heft package-solution --production",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "start": "npm run tailwind-build && concurrently --kill-others \"npm:tailwind-watch\" \"npm:tailwind-sync\" \"npm:heft-start\"",
    "tailwind-build": "tailwindcss -c tailwind.config.js -i src/webparts/onboardingTracker/tailwind.css -o tailwind.generated.css --minify && node scripts/sync-tailwind-css.js",
    "tailwind-watch": "tailwindcss -c tailwind.config.js -i src/webparts/onboardingTracker/tailwind.css -o tailwind.generated.css --watch",
    "tailwind-sync": "node scripts/watch-generated-css.js",
    "heft-start": "node --env-file=.env node_modules/@rushstack/heft/bin/heft start --clean"
  },
  "dependencies": {
    "@fluentui/react": "^8.106.4",
    "@meysam213/iconsax-react": "^1.0.4",
    "@microsoft/load-themed-styles": "^1.10.295",
    "@microsoft/sp-component-base": "1.23.2",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-http": "1.23.2",
    "@microsoft/sp-lodash-subset": "1.23.2",
    "@microsoft/sp-office-ui-fabric-core": "1.23.2",
    "@microsoft/sp-property-pane": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.23.2",
    "@microsoft/eslint-plugin-spfx": "1.23.2",
    "@microsoft/sp-module-interfaces": "1.23.2",
    "@microsoft/spfx-heft-plugins": "1.23.2",
    "@microsoft/spfx-web-build-rig": "1.23.2",
    "@rushstack/heft": "1.2.17",
    "@types/jest": "30.0.0",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/webpack-env": "~1.15.2",
    "concurrently": "^10.0.6",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.0"
  },
  "overrides": {
    "@rushstack/heft": "1.2.17"
  },
  "resolutions": {
    "@types/react": "17.0.45"
  }
}
